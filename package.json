{
  "name": "@stackgauge/mcp-slim",
  "version": "1.4.0",
  "description": "Audit MCP server configs for security risks and token bloat — zero-dependency CLI for Claude, Cursor & Windsurf.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "windsurf",
    "cli",
    "security",
    "tokens"
  ],
  "license": "MIT",
  "author": "Sandip Gami",
  "contributors": [
    "Sandip Gami"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stackgauge/mcp-slim.git"
  },
  "bugs": {
    "url": "https://github.com/stackgauge/mcp-slim/issues"
  },
  "homepage": "https://github.com/stackgauge/mcp-slim#readme",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "mcp-slim": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --loader ts-node/esm src/cli.ts",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
